# Application Settings
APP_NAME=SchemaGenius AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (Frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application PostgreSQL Database
DATABASE_URL=postgresql://schemagenuis_user:schemagenuis_dev_password@localhost:5432/schemagenuis_db

# SQL Sandbox PostgreSQL Database (Isolated)
SANDBOX_DATABASE_URL=postgresql://sandbox_user:sandbox_dev_password@localhost:5433/sandbox_db

# Firebase Authentication
# Download your Firebase service account JSON and place it outside the repo
# Then provide the absolute path here
FIREBASE_CREDENTIALS_PATH=

# Or use Firebase credentials JSON (for production environments)
# FIREBASE_CREDENTIALS_JSON=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# Sandbox Security Settings
SANDBOX_MAX_EXECUTION_TIME_SECONDS=30
SANDBOX_MAX_QUERY_LENGTH=10000
SANDBOX_MAX_TABLES_PER_SESSION=50

# Rate Limiting (requests per minute)
AI_GENERATION_RATE_LIMIT=10
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=INFO
